# SmartSpend AI Environment Configuration

# Application Settings
APP_NAME=SmartSpend AI
DEBUG=True
API_PREFIX=/api

# Database Configuration
# For local PostgreSQL: postgresql://username:password@localhost:5432/smartspend_db
# SQLite fallback is automatically used if PostgreSQL is not configured or reachable
DATABASE_URL=sqlite:///./smartspend.db

# Optional AI LLM API (Gemini / OpenAI compatible)
# Leave blank to use the built-in deterministic rule-based AI insight engine
AI_API_KEY=
AI_API_PROVIDER=rule_based
